# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin — resolves og:image/twitter:image (the file-convention
# opengraph-image.tsx card) and canonical/RSS links to absolute URLs. Keep
# localhost for local dev; set the real origin (e.g. https://tayf.app) in
# production, otherwise social card previews point at the wrong host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron secret (to secure cron endpoints)
CRON_SECRET=your-cron-secret

# Admin panel (protects /admin and /api/admin). ADMIN_PASSWORD is what you
# type on the /admin/login page. ADMIN_SESSION_SECRET signs the session
# cookie — rotate it to invalidate all logged-in browsers.
# Generate a strong secret with:  openssl rand -base64 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-32-plus-char-random-string


# Neutral-headline cron (/api/cron/headline). Without it titles are never rewritten.
ANTHROPIC_API_KEY=

# Weekly digest newsletter. Without RESEND_API_KEY sending is a no-op.
RESEND_API_KEY=
NEWSLETTER_FROM=Tayf <bulten@tayfhaber.com>

# Supabase function secrets (set with `supabase secrets set`, not here):
#   REVALIDATE_URL=https://www.tayfhaber.com/api/revalidate
#   CRON_SECRET=<same value as above>
