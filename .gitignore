# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local
supabase/functions/.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/
team/
skills.md

# supabase local
supabase/.temp/

# local session noise — Windows stack dumps, baseline logs, transcripts.
bash.exe.stackdump
.tsc-baseline.log
.vitest-baseline.log
2026-*-from-my-github*
qa/

# Per-directory agent-config files left by upstream tooling.
**/CLAUDE.md

# Deno lockfiles are generated by `deno check`; the Edge runtime resolves
# npm: specifiers itself, so they are not committed.
supabase/functions/**/deno.lock
